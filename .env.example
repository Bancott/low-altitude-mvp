# 天地图浏览器端 key（可选）。申请：https://console.tianditu.gov.cn/
VITE_TIANDITU_KEY=

# Maputnik / TileServer GL 自定义底图（可选）。
# 配置后底图菜单会出现“自定义地图”；配置 BASE_URL 会一次出现 6 套配色。
# 单套：VITE_CUSTOM_MAP_URL=http://localhost:8080/styles/low-altitude-paper/{z}/{x}/{y}.png
VITE_CUSTOM_MAP_URL=
# 多套：VITE_CUSTOM_MAP_BASE_URL=http://localhost:8080/styles
VITE_CUSTOM_MAP_BASE_URL=
VITE_CUSTOM_MAP_CREDIT=© OpenMapTiles · © OpenStreetMap contributors
